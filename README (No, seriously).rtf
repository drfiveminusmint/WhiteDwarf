 }
\par \pard\plain \s21\rtlch\af5\afs24\alang1081 \ltrch\lang1033\langfe1081\hich\af0\loch\ql\nowidctlpar\hyphpar0\ltrpar\cf0\f0\fs24\lang1033\kerning1\dbch\af7\langfe1081\ql\rtlch\afs24 \ltrch\loch\fs24\loch

